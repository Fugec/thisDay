{
  "name": "thisday-seo-worker",
  "compatibility_date": "2026-03-14",
  "main": "js/seo-worker.js",
  "kv_namespaces": [
    {
      "binding": "EVENTS_KV",
      "id": "39d7ce85d93a49c5bb42ee6f2416b1e0",
      "preview_id": "7e94191271854d90ae9f7a0cc13555d5"
    },
    {
      "binding": "BLOG_AI_KV",
      "id": "5173c34a7bd04cde9988c0e89d77bb6e",
      "preview_id": "c1b308dd3ea14b36aa123f007a07b7de"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Mirrors wrangler-blog.jsonc's GROQ_QUOTA_POOL_IDS fix (2026-08-05):
    // this worker only has GROQ_API_KEY (slot 1) and GROQ_API_KEY_3 (slot 3)
    // deployed, but without labels here too they'd share one "groq:shared"
    // circuit and defeat the per-account isolation the blog worker now has,
    // since both workers write provider-circuit state to the same
    // BLOG_AI_KV namespace. Labels match the blog worker's account identity
    // for the same key slots.
    "GROQ_QUOTA_POOL_IDS": "acct1,,acct3"
  }
}
